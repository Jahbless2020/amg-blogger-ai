# Environment variable examples (do NOT put secrets here)
# Copy these names and set them in your host's secret manager or local environment.

# Base64-encoded JSON files (use base64 of the file contents; single-line)
B64_CREDENTIALS_JSON=your_base64_encoded_credentials_json_here
B64_TOKEN_JSON=your_base64_encoded_token_json_here

# API keys and tokens
TELEGRAM_TOKEN=123456:ABCDEF_your_bot_token_here
GEMINI_API_KEY=ya29.your_gemini_api_key_here
BLOG_ID=1234567890123456789
